{
  "openapi": "3.0.1",
  "info": {
    "title": "JwtApi",
    "version": "v1"
  },
  "paths": {
    "/Auth": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Realiza a autenticação do usuário.",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "senha",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "papel",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Autenticação realizada com sucesso"
          },
          "401": {
            "description": "Credenciais inválidas"
          }
        }
      }
    },
    "/Usuario": {
      "get": {
        "tags": [
          "Usuario"
        ],
        "summary": "Busca todos usuários.",
        "responses": {
          "200": {
            "description": "Lista de usuários obtida com sucesso"
          },
          "400": {
            "description": "Dados inválidos"
          }
        }
      },
      "post": {
        "tags": [
          "Usuario"
        ],
        "summary": "Cria um novo usuário.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioInput"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioInput"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Usuário criado com sucesso"
          },
          "400": {
            "description": "Dados inválidos"
          }
        }
      },
      "put": {
        "tags": [
          "Usuario"
        ],
        "summary": "Atualiza os dados de um usuário existente.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioInput"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioInput"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado com sucesso"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "404": {
            "description": "Usuário não encontrado"
          }
        }
      }
    },
    "/Usuario/{id}": {
      "get": {
        "tags": [
          "Usuario"
        ],
        "summary": "Buscando usuário específico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do usuário obtido com sucesso"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "404": {
            "description": "Usuário não encontrado"
          }
        }
      },
      "patch": {
        "tags": [
          "Usuario"
        ],
        "summary": "Remove um usuário do sistema.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador do usuário.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário removido com sucesso"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "404": {
            "description": "Usuário não encontrado"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UsuarioInput": {
        "required": [
          "email",
          "nome",
          "senha"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "nome": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "senha": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Digite 'Bearer {seu_token}' para autenticação",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}